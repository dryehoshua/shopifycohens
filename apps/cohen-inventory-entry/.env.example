# Credenciales de la aplicación Shopify.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders

# La plantilla local usa prisma/dev.sqlite. Antes de producción se debe migrar
# el datasource a una base administrada y habilitar DATABASE_URL.
DATABASE_URL=

# Fuente de ventas del módulo "Analíticos de utilidad".
# Usa una app personalizada de solo lectura; este token nunca se confirma en Git.
COHENS_SOURCE_SHOP=source-shop.myshopify.com
COHENS_SOURCE_SHOP_NAME=Tienda fuente
COHENS_SOURCE_ADMIN_TOKEN=
COHENS_EXPECTED_OLDEST_ORDER=

# URL del administrador hasta la aplicación instalada, sin la ruta del módulo.
# Ejemplo: https://admin.shopify.com/store/store-handle/apps/app-handle
SHOPIFY_ADMIN_APP_URL=

# Sólo para utilidades de migración y diagnóstico en una tienda de desarrollo.
SHOPIFY_DEV_STORE=development-store.myshopify.com
