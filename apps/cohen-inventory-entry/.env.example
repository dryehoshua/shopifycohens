# Credenciales de la aplicación Shopify.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.example.com
# Orígenes adicionales que pueden consultar el puente NFC local, separados
# por coma. Localhost y la URL productiva principal ya están autorizados.
# NEKUDOT_NFC_ALLOWED_ORIGINS=https://cohens-cafe.example.com
# Shopify Admin puede bloquear conexiones a localhost. El puente usa de forma
# predeterminada la entrada segura al campo Nekudot enfocado; usa 0 para apagarla.
# NEKUDOT_NFC_KEYBOARD_FALLBACK=0
SCOPES=read_products,write_products,read_publications,write_publications,read_inventory,write_inventory,read_locations,read_orders,write_orders,read_all_orders,read_customers

# HMAC global de IDs RFID/QR de Nekudot. Debe ser idéntico para tienda y
# cafetería cuando comparten el programa; nunca se guarda el ID original.
# Si se omite, el backend usa SHOPIFY_API_SECRET como respaldo.
NEKUDOT_TOKEN_SECRET=

# SQLite local. En Railway se configura como file:/data/dev.sqlite y se monta
# un volumen persistente en /data.
DATABASE_URL=file:dev.sqlite

# Fuente de ventas del módulo "Analíticos de utilidad".
# Usa una app personalizada de solo lectura; este token nunca se confirma en Git.
COHENS_SOURCE_SHOP=source-shop.myshopify.com
COHENS_SOURCE_SHOP_NAME=Tienda fuente
COHENS_SOURCE_ADMIN_TOKEN=
COHENS_EXPECTED_OLDEST_ORDER=

# URL del administrador hasta la aplicación instalada, sin la ruta del módulo.
# Ejemplo: https://admin.shopify.com/store/store-handle/apps/app-handle
SHOPIFY_ADMIN_APP_URL=

# Sólo para utilidades de migración y diagnóstico en una tienda de desarrollo.
SHOPIFY_DEV_STORE=development-store.myshopify.com

# Perfil productivo aislado para la tienda de cafetería.
CAFE_POS_ENABLED=false
CAFE_SHOP_DOMAIN=cohens-cafe.myshopify.com
CAFE_LOCATION_NAME=Cohen's Cafe
# Credenciales del gerente. Configurarlas como variables secretas en producción.
CAFE_MANAGER_NAME=Nombre del gerente
CAFE_MANAGER_PIN=
# IVA incluido expresado en puntos base. 1600 = 16 %. Validar con el contador.
CAFE_TAX_RATE_BPS=1600
