// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Registro operacional de cada entrada o reversión de inventario.
///
/// Los movimientos confirmados nunca se eliminan ni se sobreescriben. Una
/// corrección se guarda como un segundo movimiento con `reversalOfId`.
model InventoryMovement {
  id             String   @id @default(cuid())
  shop           String
  idempotencyKey String   @unique
  type           String
  status         String   @default("PENDING")
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId        String?
  staffMemberId String?
  locationId    String
  deviceId      String?

  barcode         String
  sku             String?
  productId       String
  productTitle    String
  variantId       String
  variantTitle    String?
  inventoryItemId String

  quantityDelta    Int
  reason           String
  supplier         String?
  supplierRecordId String?
  supplierRecord   Supplier? @relation(fields: [supplierRecordId], references: [id], onDelete: SetNull)
  note             String?
  beforeAvailable  Int?
  afterAvailable   Int?

  referenceDocumentUri     String
  shopifyAdjustmentGroupId String?
  shopifyAdjustmentAt      DateTime?
  shopifyAdjustmentReason  String?
  requestPayload           Json?
  responsePayload          Json?
  errorMessage             String?
  reconciliationStatus     String    @default("PENDING")
  reconciledAt             DateTime?
  reconciliationError      String?

  reversalOfId         String?                        @unique
  reversalOf           InventoryMovement?             @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal             InventoryMovement?             @relation("MovementReversal")
  reconciliationIssues InventoryReconciliationIssue[]

  @@index([shop, occurredAt])
  @@index([shop, barcode])
  @@index([shop, locationId])
  @@index([supplierRecordId])
  @@index([status])
}

/// Catálogo de proveedores disponible en el selector de recepción.
///
/// Se alimenta de los proveedores/marcas existentes en los productos de Shopify
/// y permite registrar proveedores adicionales sin modificar el catálogo.
model Supplier {
  id             String   @id @default(cuid())
  shop           String
  name           String
  normalizedName String
  source         String   @default("MANUAL")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([shop, normalizedName])
  @@index([shop, active, name])
}

/// Copia local de los webhooks que pueden explicar cambios o eliminaciones.
/// Conserva el payload aun si el producto o artículo deja de existir en Shopify.
model InventoryAuditEvent {
  id                   String                         @id @default(cuid())
  webhookId            String                         @unique
  shop                 String
  topic                String
  occurredAt           DateTime?
  capturedAt           DateTime                       @default(now())
  resourceId           String?
  locationId           String?
  inventoryItemId      String?
  productId            String?
  payload              Json
  reconciliationIssues InventoryReconciliationIssue[]

  @@index([shop, capturedAt])
  @@index([shop, topic])
  @@index([inventoryItemId])
  @@index([productId])
}

/// Una ejecución idempotente del conciliador de inventario. El proceso sólo
/// consulta Shopify y actualiza evidencia local; nunca corrige existencias.
model InventoryReconciliationRun {
  id                 String    @id @default(cuid())
  shop               String
  triggerKey         String
  source             String
  status             String    @default("RUNNING")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  movementsExamined  Int       @default(0)
  movementsMatched   Int       @default(0)
  externalChanges    Int       @default(0)
  uncertainMovements Int       @default(0)
  pendingSales       Int       @default(0)
  openIssues         Int       @default(0)
  errorMessage       String?
  metadata           Json?

  @@unique([shop, triggerKey])
  @@index([shop, startedAt])
  @@index([status, startedAt])
}

/// Incidencia accionable producida por la conciliación. Los cambios externos
/// se agrupan por artículo y ubicación para evitar una alerta por cada venta.
model InventoryReconciliationIssue {
  id                String               @id @default(cuid())
  fingerprint       String               @unique
  shop              String
  kind              String
  status            String               @default("OPEN")
  severity          String               @default("WARNING")
  source            String
  occurredAt        DateTime?
  locationId        String?
  locationName      String?
  inventoryItemId   String?
  productId         String?
  variantId         String?
  productTitle      String?
  variantTitle      String?
  sku               String?
  barcode           String?
  quantityDelta     Int?
  expectedAvailable Int?
  actualAvailable   Int?
  movementId        String?
  movement          InventoryMovement?   @relation(fields: [movementId], references: [id], onDelete: SetNull)
  auditEventId      String?
  auditEvent        InventoryAuditEvent? @relation(fields: [auditEventId], references: [id], onDelete: SetNull)
  localRecordType   String?
  localRecordId     String?
  summary           String
  detail            String
  metadata          Json?
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNote        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([shop, status, occurredAt])
  @@index([shop, kind, status])
  @@index([inventoryItemId, locationId])
  @@index([movementId])
  @@index([auditEventId])
}

/// Ejecución auditable de una importación o sincronización de ventas.
///
/// El historial de una ejecución fallida se conserva; una ejecución posterior
/// actualiza los pedidos de manera idempotente mediante su ID de Shopify.
model SalesSyncRun {
  id             String    @id @default(cuid())
  sourceShop     String
  source         String    @default("SHOPIFY_ADMIN_API")
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  costCapturedAt DateTime  @default(now())
  ordersSeen     Int       @default(0)
  ordersImported Int       @default(0)
  lineItemsSeen  Int       @default(0)
  refundsSeen    Int       @default(0)
  oldestOrderAt  DateTime?
  newestOrderAt  DateTime?
  errorMessage   String?
  metadata       Json?

  orders        SalesOrder[]
  costSnapshots ProductCostSnapshot[]

  @@index([sourceShop, startedAt])
  @@index([status])
}

/// Copia local de un pedido de la tienda productiva.
///
/// Los importes se guardan en centavos para evitar errores de redondeo.
model SalesOrder {
  id                    String    @id @default(cuid())
  sourceShop            String
  shopifyOrderId        String
  name                  String
  createdAt             DateTime
  processedAt           DateTime?
  shopifyUpdatedAt      DateTime
  importedAt            DateTime  @default(now())
  cancelledAt           DateTime?
  currencyCode          String
  financialStatus       String?
  fulfillmentStatus     String?
  sourceName            String?
  test                  Boolean   @default(false)
  includedInProfit      Boolean   @default(false)
  originalSalesCents    Int       @default(0)
  discountCents         Int       @default(0)
  refundedProductCents  Int       @default(0)
  refundedPaymentCents  Int       @default(0)
  netSalesCents         Int       @default(0)
  taxCents              Int       @default(0)
  currentTotalCents     Int       @default(0)
  originalItemQuantity  Int       @default(0)
  netItemQuantity       Int       @default(0)
  calculableCostCents   Int       @default(0)
  calculableProfitCents Int       @default(0)
  coveredNetSalesCents  Int       @default(0)
  missingCostSalesCents Int       @default(0)
  profitComplete        Boolean   @default(false)
  rawPayload            Json?

  lastSyncRunId String?
  lastSyncRun   SalesSyncRun? @relation(fields: [lastSyncRunId], references: [id], onDelete: SetNull)

  lineItems SalesLineItem[]
  refunds   SalesRefund[]

  @@unique([sourceShop, shopifyOrderId])
  @@index([sourceShop, createdAt])
  @@index([sourceShop, includedInProfit, createdAt])
  @@index([sourceShop, name])
  @@index([lastSyncRunId])
}

/// Partida de venta con venta neta y costo vigente capturado.
model SalesLineItem {
  id                     String     @id @default(cuid())
  orderId                String
  order                  SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyLineItemId      String
  shopifyProductId       String?
  shopifyVariantId       String?
  shopifyInventoryItemId String?
  productHandle          String?
  productTitle           String
  variantTitle           String?
  sku                    String?
  originalQuantity       Int
  netQuantity            Int
  refundedQuantity       Int        @default(0)
  originalUnitPriceCents Int
  originalSalesCents     Int
  discountCents          Int        @default(0)
  refundedSalesCents     Int        @default(0)
  netSalesCents          Int
  currentUnitCostCents   Int?
  calculatedCostCents    Int?
  calculatedProfitCents  Int?
  marginBasisPoints      Int?
  costSource             String?
  costCapturedAt         DateTime?
  missingCostReason      String?
  importedAt             DateTime   @default(now())
  rawPayload             Json?

  @@unique([orderId, shopifyLineItemId])
  @@index([shopifyVariantId])
  @@index([sku])
  @@index([productTitle])
}

/// Reembolso financiero y sus cantidades de producto asociadas.
model SalesRefund {
  id                    String     @id @default(cuid())
  orderId               String
  order                 SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyRefundId       String
  createdAt             DateTime
  updatedAt             DateTime
  successfulAmountCents Int        @default(0)
  productSubtotalCents  Int        @default(0)
  productQuantity       Int        @default(0)
  transactionStatus     String?
  rawPayload            Json?

  @@unique([orderId, shopifyRefundId])
  @@index([createdAt])
}

/// Historial del valor "Costo por artículo" utilizado en cada sincronización.
model ProductCostSnapshot {
  id                     String       @id @default(cuid())
  sourceShop             String
  shopifyProductId       String?
  shopifyVariantId       String
  shopifyInventoryItemId String?
  productHandle          String?
  productTitle           String
  variantTitle           String?
  sku                    String?
  unitCostCents          Int?
  currencyCode           String
  source                 String       @default("SHOPIFY_INVENTORY_ITEM_UNIT_COST")
  capturedAt             DateTime     @default(now())
  syncRunId              String
  syncRun                SalesSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@unique([syncRunId, shopifyVariantId])
  @@index([sourceShop, shopifyVariantId, capturedAt])
  @@index([sourceShop, sku, capturedAt])
}

/// Empleado autorizado para operar la caja web de Cohen's Cafe.
/// El PIN nunca se guarda en texto; se conserva únicamente scrypt + sal.
model CafeStaff {
  id             String   @id @default(cuid())
  shop           String
  name           String
  normalizedName String
  pinSalt        String
  pinHash        String
  role           String   @default("CASHIER")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions CafePosSession[]
  shifts   CafeRegisterShift[]
  sales    CafeSale[]

  @@unique([shop, normalizedName])
  @@index([shop, active, name])
}

/// Sesión de la POS pública. El navegador recibe el token original en una
/// cookie HttpOnly; la base conserva solamente su hash SHA-256.
model CafePosSession {
  id         String    @id @default(cuid())
  shop       String
  tokenHash  String    @unique
  staffId    String
  staff      CafeStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([shop, expiresAt])
  @@index([staffId, revokedAt])
}

/// Turno de caja para conciliación de efectivo y terminal externa.
model CafeRegisterShift {
  id                    String    @id @default(cuid())
  shop                  String
  staffId               String
  staff                 CafeStaff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  status                String    @default("OPEN")
  openedAt              DateTime  @default(now())
  openingCashCents      Int       @default(0)
  closedAt              DateTime?
  closingCashCents      Int?
  expectedCashCents     Int?
  cashVarianceCents     Int?
  terminalCountedCents  Int?
  terminalExpectedCents Int?
  terminalVarianceCents Int?
  notes                 String?

  sales CafeSale[]

  @@index([shop, status, openedAt])
  @@index([staffId, openedAt])
}

/// Intento de venta de la POS. Se crea antes de llamar a Shopify para poder
/// reintentar y reconciliar sin duplicar pedidos después de una falla de red.
model CafeSale {
  id                   String            @id @default(cuid())
  shop                 String
  idempotencyKey       String
  status               String            @default("PENDING")
  staffId              String
  staff                CafeStaff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  shiftId              String
  shift                CafeRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  paymentMethod        String
  externalReference    String?
  subtotalCents        Int
  taxCents             Int               @default(0)
  totalCents           Int
  currencyCode         String            @default("MXN")
  items                Json
  customerId           String?
  customerName         String?
  customerEmail        String?
  shopifyOrderId       String?
  shopifyOrderName     String?
  errorMessage         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  syncedAt             DateTime?
  lastPrintedAt        DateTime?
  printCount           Int               @default(0)
  cancelledAt          DateTime?
  cancelledByName      String?
  refundedAt           DateTime?
  refundedByName       String?
  shopifyRefundId      String?
  refundIdempotencyKey String?           @unique
  nekudotMemberId      String?
  nekudotRedemptionId  String?
  nekudotRedeemedCents Int               @default(0)

  @@unique([shop, idempotencyKey])
  @@index([shop, createdAt])
  @@index([shop, status, createdAt])
  @@index([shiftId, paymentMethod])
  @@index([shopifyOrderId])
  @@index([customerId])
  @@index([nekudotMemberId])
  @@index([nekudotRedemptionId])
}

/// Empleado autorizado para operar la POS de tienda. Se mantiene separado del
/// personal y los turnos de cafetería porque los permisos operativos difieren.
model RetailStaff {
  id             String   @id @default(cuid())
  shop           String
  name           String
  normalizedName String
  pinSalt        String
  pinHash        String
  role           String   @default("CASHIER")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions RetailPosSession[]
  shifts   RetailRegisterShift[]
  sales    RetailSale[]

  @@unique([shop, normalizedName])
  @@index([shop, active, name])
}

/// Sesión independiente de la POS de tienda. El token original solo vive en
/// una cookie HttpOnly y la base conserva su hash.
model RetailPosSession {
  id         String      @id @default(cuid())
  shop       String
  tokenHash  String      @unique
  staffId    String
  staff      RetailStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([shop, expiresAt])
  @@index([staffId, revokedAt])
}

/// Turno de la caja retail. Efectivo y terminal se concilian por separado,
/// incluyendo pagos mixtos.
model RetailRegisterShift {
  id                    String      @id @default(cuid())
  shop                  String
  staffId               String
  staff                 RetailStaff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  status                String      @default("OPEN")
  openedAt              DateTime    @default(now())
  openingCashCents      Int         @default(0)
  closedAt              DateTime?
  closingCashCents      Int?
  expectedCashCents     Int?
  cashVarianceCents     Int?
  terminalCountedCents  Int?
  terminalExpectedCents Int?
  terminalVarianceCents Int?
  notes                 String?

  sales RetailSale[]

  @@index([shop, status, openedAt])
  @@index([staffId, openedAt])
}

/// Venta retail local e idempotente. Shopify conserva el pedido oficial y el
/// inventario; este registro protege contra cobros o pedidos duplicados.
model RetailSale {
  id                   String              @id @default(cuid())
  shop                 String
  idempotencyKey       String
  status               String              @default("PENDING")
  staffId              String
  staff                RetailStaff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  shiftId              String
  shift                RetailRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  paymentMethod        String
  externalReference    String?
  grossCents           Int
  discountCents        Int                 @default(0)
  subtotalCents        Int
  taxCents             Int                 @default(0)
  totalCents           Int
  cashPaidCents        Int                 @default(0)
  terminalPaidCents    Int                 @default(0)
  cashReceivedCents    Int?
  changeCents          Int                 @default(0)
  currencyCode         String              @default("MXN")
  items                Json
  customerId           String?
  customerName         String?
  customerEmail        String?
  shopifyOrderId       String?
  shopifyOrderName     String?
  errorMessage         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  syncedAt             DateTime?
  lastPrintedAt        DateTime?
  printCount           Int                 @default(0)
  refundedAt           DateTime?
  refundedByName       String?
  shopifyRefundId      String?
  refundIdempotencyKey String?             @unique
  nekudotMemberId      String?
  nekudotRedemptionId  String?
  nekudotRedeemedCents Int                 @default(0)

  @@unique([shop, idempotencyKey])
  @@index([shop, createdAt])
  @@index([shop, status, createdAt])
  @@index([shiftId, createdAt])
  @@index([shopifyOrderId])
  @@index([customerId])
  @@index([nekudotMemberId])
  @@index([nekudotRedemptionId])
}

/// Miembro único del programa Nekudot Cohen's. Su wallet se comparte entre
/// todas las tiendas Shopify conectadas al mismo backend.
model NekudotMember {
  id                    String         @id @default(cuid())
  programKey            String         @default("cohens")
  displayName           String
  email                 String?
  phone                 String?
  community             String?
  photoFileName         String?
  active                Boolean        @default(true)
  cardTier              String         @default("SILVER")
  enrollmentStatus      String         @default("ACTIVE")
  currencyCode          String         @default("MXN")
  balanceCents          Int            @default(0)
  reservedCents         Int            @default(0)
  lifetimeEarnedCents   Int            @default(0)
  lifetimeRedeemedCents Int            @default(0)
  brokerId              String?
  broker                NekudotBroker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  identities         NekudotCustomerIdentity[]
  credentials        NekudotCredential[]
  ledger             NekudotLedgerEntry[]
  accruals           NekudotOrderAccrual[]
  redemptions        NekudotRedemption[]
  portalSessions     NekudotPortalSession[]
  membershipPayments NekudotMembershipPayment[]
  ownedBroker        NekudotBroker?             @relation("NekudotBrokerOwner")
  claimedOrders      NekudotPendingClaim[]      @relation("NekudotClaimedMember")

  @@index([programKey, active, updatedAt])
  @@index([brokerId, active])
  @@index([programKey, displayName])
}

/// Sesion del portal del miembro creada solamente despues de validar un OTP.
/// El navegador conserva el token y la base unicamente su hash SHA-256.
model NekudotPortalSession {
  id         String        @id @default(cuid())
  tokenHash  String        @unique
  memberId   String
  member     NekudotMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([memberId, expiresAt])
}

/// Suscripcion mensual Golden mediante Mercado Pago. Los webhooks firmados
/// mantienen sincronizados el cobro, la autorizacion y las pausas/cancelaciones.
model NekudotMembershipPayment {
  id                String        @id @default(cuid())
  memberId          String
  member            NekudotMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  provider          String        @default("MERCADO_PAGO")
  status            String        @default("PENDING")
  externalReference String        @unique
  preferenceId      String?       @unique
  subscriptionId    String?       @unique
  paymentId         String?       @unique
  amountCents       Int
  currencyCode      String        @default("MXN")
  checkoutUrl       String?
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?

  @@index([memberId, status, createdAt])
}

/// Perfil comercial del broker. La comisión no se mezcla con los Nekudot
/// canjeables del cliente y puede conciliarse o pagarse por separado.
model NekudotBroker {
  id                      String         @id @default(cuid())
  programKey              String         @default("cohens")
  code                    String
  displayName             String
  email                   String?
  phone                   String?
  community               String?
  referralWord            String?
  active                  Boolean        @default(true)
  commissionBalanceCents  Int            @default(0)
  lifetimeCommissionCents Int            @default(0)
  paidOutCents            Int            @default(0)
  ownerMemberId           String?        @unique
  ownerMember             NekudotMember? @relation("NekudotBrokerOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  clients        NekudotMember[]
  ledger         NekudotLedgerEntry[]
  accruals       NekudotOrderAccrual[]
  portalSessions NekudotBrokerSession[]

  @@unique([programKey, code])
  @@unique([programKey, referralWord])
  @@index([programKey, active, displayName])
}

/// Sesion privada de un IB creada despues de verificar por SMS el telefono
/// registrado en su perfil. El token original nunca se guarda en la base.
model NekudotBrokerSession {
  id         String        @id @default(cuid())
  tokenHash  String        @unique
  brokerId   String
  broker     NekudotBroker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([brokerId, expiresAt])
}

/// Enlace entre el miembro central y su perfil de cliente en cada tienda.
model NekudotCustomerIdentity {
  id                      String        @id @default(cuid())
  programKey              String        @default("cohens")
  memberId                String
  member                  NekudotMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shop                    String
  shopifyCustomerId       String
  shopifyLegacyCustomerId String
  displayName             String
  email                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([shop, shopifyCustomerId])
  @@unique([memberId, shop])
  @@index([programKey, shop, displayName])
}

/// RFID o QR global. El valor original nunca se persiste.
model NekudotCredential {
  id            String        @id @default(cuid())
  programKey    String        @default("cohens")
  memberId      String
  member        NekudotMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash     String
  lastFour      String
  kind          String        @default("RFID_OR_QR")
  label         String?
  active        Boolean       @default(true)
  revokedAt     DateTime?
  revokedReason String?
  revokedByShop String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([programKey, tokenHash])
  @@index([memberId, active])
}

/// Libro mayor inmutable para cashback, comisión, canje, reversión y pagos.
model NekudotLedgerEntry {
  id                String         @id @default(cuid())
  programKey        String         @default("cohens")
  memberId          String?
  member            NekudotMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  brokerId          String?
  broker            NekudotBroker? @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  walletType        String
  type              String
  amountCents       Int
  balanceAfterCents Int
  currencyCode      String         @default("MXN")
  shop              String?
  source            String
  sourceId          String?
  idempotencyKey    String
  description       String
  occurredAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  metadata          Json?

  @@unique([programKey, idempotencyKey])
  @@index([memberId, occurredAt])
  @@index([brokerId, occurredAt])
  @@index([programKey, shop, occurredAt])
  @@index([programKey, source, sourceId])
}

/// Resultado vigente de aplicar la tasa de la tarjeta al cliente y 5% a su broker.
model NekudotOrderAccrual {
  id                    String         @id @default(cuid())
  programKey            String         @default("cohens")
  shop                  String
  shopifyOrderId        String
  orderName             String
  memberId              String
  member                NekudotMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  brokerId              String?
  broker                NekudotBroker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  cashbackTier          String         @default("BLUE")
  cashbackBasisPoints   Int            @default(500)
  originalPurchaseCents Int
  purchaseCents         Int
  clientEarnedCents     Int
  brokerEarnedCents     Int
  currencyCode          String         @default("MXN")
  calculationHash       String
  processedAt           DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([shop, shopifyOrderId])
  @@index([memberId, processedAt])
  @@index([brokerId, processedAt])
  @@index([programKey, processedAt])
}

/// Reserva temporal de saldo iniciada en POS. Sólo se carga al libro mayor
/// cuando el webhook confirma el pedido pagado.
model NekudotRedemption {
  id             String        @id @default(cuid())
  programKey     String        @default("cohens")
  memberId       String
  member         NekudotMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shop           String
  amountCents    Int
  restoredCents  Int           @default(0)
  status         String        @default("RESERVED")
  idempotencyKey String
  cartReference  String?
  shopifyOrderId String?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appliedAt      DateTime?
  cancelledAt    DateTime?

  @@unique([programKey, idempotencyKey])
  @@index([memberId, status, expiresAt])
  @@index([shop, shopifyOrderId])
}

/// Compra online hecha sin una identidad Nekudot verificable. El contacto se
/// guarda únicamente como HMAC y sólo se enlaza después de validar un OTP.
model NekudotPendingClaim {
  id                      String         @id @default(cuid())
  programKey              String         @default("cohens")
  shop                    String
  shopifyOrderId          String
  orderName               String
  currencyCode            String         @default("MXN")
  purchaseCents           Int
  eligibleFinancialStatus Boolean        @default(false)
  cancelled               Boolean        @default(false)
  orderUpdatedAt          DateTime
  emailHash               String?
  phoneHash               String?
  status                  String         @default("PENDING")
  claimedMemberId         String?
  claimedMember           NekudotMember? @relation("NekudotClaimedMember", fields: [claimedMemberId], references: [id], onDelete: SetNull)
  expiresAt               DateTime
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  claimedAt               DateTime?

  @@unique([shop, shopifyOrderId])
  @@index([programKey, status, expiresAt])
  @@index([phoneHash, status])
  @@index([emailHash, status])
  @@index([claimedMemberId, claimedAt])
}

/// Intento temporal para vincular un registro nuevo con un cliente Shopify ya
/// existente. La vinculación sólo concluye después de validar el contacto previo.
model NekudotRegistrationRecovery {
  id                String    @id @default(cuid())
  programKey        String    @default("cohens")
  shop              String
  shopifyCustomerId String
  requestedKind     String
  requestedData     Json
  destinationPhone  String?
  maskedPhone       String?
  maskedEmail       String?
  status            String    @default("PENDING")
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  verifiedAt        DateTime?

  @@index([programKey, status, expiresAt])
  @@index([shop, shopifyCustomerId, status])
}
